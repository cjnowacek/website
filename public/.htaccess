# Root .htaccess for the Astro build (ships via public/ -> dist/).
# The static site is plain directories with index.html; PHP survives only in
# /includes/contact_handler.php (contact form) and /play/ (room directory).

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# HTML must never be served stale (SiteGround's dynamic cache kept serving
# pre-deploy pages — same fix as the old PHP header). Astro's /_astro/ assets
# have content-hashed names, so they can cache forever.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^[^.]+\.[A-Za-z0-9_-]{8,}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /

# Never rewrite the live PHP endpoints (POST targets — a redirect would drop the body).
RewriteRule ^(includes|play)(/|$) - [L]

# Old Whisper slugs and singular/plural typo permutations -> canonical
# (renamed Jul 2026 to match the game's actual title; canonical is
# whispers-from-the-star, which must NOT match here or it would loop)
RewriteRule ^(?:pages-techart|techart)/(whisper-from-the-stars|whispers-from-the-stars|whisper-from-the-star)(/.*)?$ /techart/whispers-from-the-star$2 [R=301,L]

# Retired pages: build-pipeline was deleted (content matched neither resume);
# media-lab was renamed to ml3ds
RewriteRule ^(?:pages-devops|devops)/build-pipeline(/.*)?$ /devops/ [R=301,L]
RewriteRule ^devops/media-lab(/.*)?$ /devops/ml3ds/ [R=301,L]

# Old URLs, permanently moved:
#   /pages-techart/foo/ -> /techart/foo/   (project pages)
#   /pages-devops/foo/  -> /devops/foo/
RewriteRule ^pages-techart/(.*)$ /techart/$1 [R=301,L]
RewriteRule ^pages-devops/(.*)$ /devops/$1 [R=301,L]

# /index.php (any directory) -> the directory itself
RewriteRule ^(.*/)?index\.php$ /$1 [R=301,L]

# /foo.php -> /foo (old flat pages: about.php, contact.php, techart.php, ...)
RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.php[\s?]
RewriteRule ^ /%1 [R=301,L]

# /notes -> the vault served by Cairn's engine on the droplet (zk-engine,
# tools/notes-vps-setup.sh). A redirect rather than a proxy: this host is
# static Apache, and the app has its own login.
RewriteRule ^notes/?$ https://notes.cjnowacek.com/ [R=302,L]
