---
// src/pages/devlog.astro — the dev log index, page 1. Posts live one per file in
// src/content/devlog/; each gets its own page at /devlog/<slug>/. Older posts
// page at /devlog/page/<n>/. Workflow: draft
// privately, publish here (scrubbed, one thing per post), promote to a project
// page when a topic earns it.
import Layout from '../layouts/Layout.astro';
import DevlogList from '../components/DevlogList.astro';
import { getPosts, PER_PAGE } from '../lib/devlog.js';

const posts = await getPosts();
const pageCount = Math.max(1, Math.ceil(posts.length / PER_PAGE));
---
<Layout title="Dev Log" description="Working notes from CJ Nowacek's pipeline bench: what is being built, what broke, and how it was fixed.">
  <DevlogList posts={posts.slice(0, PER_PAGE)} page={1} pageCount={pageCount} />
</Layout>
