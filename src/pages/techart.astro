---
// src/pages/techart.astro — ported from techart.php (+ demo_reel.php inlined)
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectCards } from '../lib/projects.js';

const techartProjects = await getProjectCards(['smite', 'runaway']);
---
<Layout title="Technical Art">
  <div class="container" style="max-width: 1300px;">
    <h2>Technical Art</h2>

    <hr />

    <div style="text-align: center; margin: 40px 0;">
      <a
        href="/static/files/CJ-Nowacek-TechArt-Resume.pdf"
        class="resume-download-btn"
        target="_blank"
        rel="noopener">Download Tech Art Resume (PDF)</a
      >
    </div>

    <!-- Demo reel (ported from includes/demo_reel.php) -->
    <div class="demo-reel">
      <div class="video-container">
        <iframe
          title="CJ Nowacek Technical Art Demo Reel"
          src="https://player.vimeo.com/video/1016947852?h=ff8595b6d0"
          frameborder="0"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
    </div>

    <h2>Focus Areas</h2>
    <div class="grid competencies-grid">
      <div class="grid-item">
        <div class="project-info">
          <h3>Character Rigging</h3>
          <p class="project-description">
            Production character rigs in 3ds Max and Maya, from modular rig builds to constraint
            systems, shipped on SMITE 2 and custom rigs for independent projects
          </p>
        </div>
      </div>

      <div class="grid-item">
        <div class="project-info">
          <h3>Rigging &amp; Animation Tools</h3>
          <p class="project-description">
            Python and MaxScript tools for automated rig builds, skin weight transfer, and animation
            export, shaped around how animators actually work
          </p>
        </div>
      </div>

      <div class="grid-item">
        <div class="project-info">
          <h3>Asset &amp; Engine Pipeline</h3>
          <p class="project-description">
            Batch asset processing, Unreal Engine 5 import workflows, and automated build and
            deployment for game projects
          </p>
        </div>
      </div>
    </div>

    <h2>Featured Projects</h2>

    <div class="projects-container projects-container-grid">
      {techartProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</Layout>
