---
// src/pages/shore-house.astro — LiDAR room scans, one per src/content/models
// entry, grouped and rendered by ModelViewer. The viewer library loads only
// when a visitor clicks a room; see the script at the end of this file.
import Layout from '../layouts/Layout.astro';
import ModelViewer from '../components/ModelViewer.astro';
import { getModels, groups } from '../lib/models.js';

const models = await getModels();
---
<Layout
  title="Shore House"
  description="LiDAR scans of a New Jersey shore house, room by room, viewable in 3D: the reference for a Blender rebuild by CJ Nowacek."
>
  <div class="container" style="max-width: 1300px;">
    <h2>Shore House</h2>
    <div class="about-text">
      <p>
        Room-by-room LiDAR scans of my family's shore house in New Jersey, captured on an iPhone
        in the summer of 2025. They are the reference for a clean Blender rebuild of the house
        that is still in progress: each room is traced over its scan, then baked to its own
        texture. The scans themselves are raw, seams and all, which is part of what I like about
        them.
      </p>
      <p>
        Click a room to load it, then drag to orbit and scroll or pinch to zoom. Each scan was
        cut down for the browser with gltf-transform (welded, simplified, quantized, its 8K
        texture re-encoded to a 1024 px WebP), so a room is a few hundred kilobytes to a megabyte
        and nothing loads until you ask for it.
      </p>
    </div>

    <div class="model-groups">
      {groups.map(([key, label]) => {
        const inGroup = models.filter((m) => m.data.group === key);
        if (inGroup.length === 0) return null;
        return (
          <>
            <h3>{label}</h3>
            <div class="model-grid">
              {inGroup.map((entry) => <ModelViewer entry={entry} />)}
            </div>
          </>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  // The viewer library (about 1 MB) loads on the first click on any room, not
  // with the page. That click happened before the element was upgraded, so
  // after the import we dismiss the clicked room's poster ourselves; from then
  // on model-viewer handles clicks itself (reveal="interaction").
  let lib;
  const load = () => (lib ??= import('@google/model-viewer'));
  for (const mv of document.querySelectorAll('model-viewer')) {
    mv.addEventListener('click', async () => {
      await load();
      await customElements.whenDefined('model-viewer');
      mv.dismissPoster();
    }, { once: true });
  }
</script>
