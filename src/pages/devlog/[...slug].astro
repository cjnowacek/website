---
// src/pages/devlog/[...slug].astro — one page per dev log post.
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getPosts, formatDate } from '../../lib/devlog.js';

export async function getStaticPaths() {
  // Newest first, so posts[i - 1] is the next newer post and posts[i + 1] the next older.
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const d = post.data;

// If the post belongs to a project, link back to that project's page.
let project = null;
if (d.project) {
  const projects = await getCollection('projects');
  const entry = projects.find((p) => p.id === d.project);
  if (entry) project = { title: entry.data.title, href: `/${entry.data.category}/${entry.id}/` };
}
---
<Layout title={`${d.title} - Dev Log`} description={d.summary} image={d.image ?? undefined} type="article">
  <div class="container" style="max-width: 1300px;">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Dev Log', href: '/devlog' }, { label: d.title }]} />

    <h2>{d.title}</h2>
    <p class="devlog-meta" style="text-align: center;">
      <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
      {project && <span> &middot; Part of <a href={project.href}>{project.title}</a></span>}
    </p>
    {d.tags.length > 0 && (
      <ul class="tech-tags devlog-tags devlog-post-tags">
        {d.tags.map((t) => <li class="tech-tag">{t}</li>)}
      </ul>
    )}

    {d.image && (
      <figure class="detail-hero">
        <img src={d.image} alt="" width="1200" height="900" />
      </figure>
    )}

    <article class="text-content devlog-body">
      <Content />
    </article>

    {(older || newer) && (
      <nav class="devlog-neighbors" aria-label="More posts">
        {older && (
          <a href={`/devlog/${older.id}/`} rel="prev">
            <small>← Older</small>{older.data.title}
          </a>
        )}
        {newer && (
          <a href={`/devlog/${newer.id}/`} rel="next" class="is-newer">
            <small>Newer →</small>{newer.data.title}
          </a>
        )}
      </nav>
    )}

    <div style="display: flex; justify-content: flex-start; max-width: var(--text-content-max-width); margin: 20px auto 40px; gap: 20px;">
      <a href="/devlog" class="project-link project-link-secondary">← All posts</a>
    </div>
  </div>
</Layout>
