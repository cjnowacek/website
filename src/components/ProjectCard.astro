---
// src/components/ProjectCard.astro — compact, fully clickable project card.
// The whole card is one <a>, so it works with keyboard and screen readers
// without any click-forwarding script. Content is deliberately minimal
// (image, title, company, one-line tagline, up to three tags): the detail
// page carries the rest.
const { project } = Astro.props;
const hasVideo = !!project.video;
const tags = (project.tech_tags ?? []).slice(0, 3);
const tagline = project.tagline ?? project.description;
const small = project.image && project.image.endsWith('-webp-1200x900.webp')
  ? project.image.replace('-1200x900.webp', '-800x600.webp')
  : null;
---
<a class="project-card" href={project.link}>
  <div class="project-media">
    {project.image ? (
      <>
        <img
          src={project.image}
          srcset={small ? `${small} 800w, ${project.image} 1200w` : undefined}
          sizes={small ? '(max-width: 600px) 100vw, (max-width: 900px) 50vw, 420px' : undefined}
          alt=""
          loading="lazy"
          width="1200"
          height="900" />
        {hasVideo && (
          <video
            class="hover-video"
            src={project.video}
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"></video>
        )}
      </>
    ) : (
      <div class="project-media-overlay" aria-hidden="true">
        <div class="media-icon">🔄</div>
      </div>
    )}
  </div>
  <div class="project-info-card">
    <h3>{project.title}</h3>
    {project.company && <p class="project-company">{project.company}</p>}
    <p class="project-tagline">{tagline}</p>
    {tags.length > 0 && (
      <ul class="tech-tags">
        {tags.map((tag) => <li class="tech-tag">{tag}</li>)}
      </ul>
    )}
  </div>
</a>
