---
// src/components/Expandable.astro — collapsible section (ports the .expandable-section
// + .expand-toggle pattern from the PHP detail pages). Slot holds the content.
// Pass `open` to start expanded (the PHP pages auto-open the first section so the
// technical depth is visible without a click).
const { title, open = false } = Astro.props;
const id = 'expand-' + title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<div class="expandable-section">
  <button
    class:list={['expand-toggle', { active: open }]}
    aria-expanded={open ? 'true' : 'false'}
    aria-controls={id}>{title} <span class="toggle-icon" aria-hidden="true">▼</span></button>
  <div id={id} class:list={['expandable-content', { active: open }]}>
    <slot />
  </div>
</div>

<script>
  // Astro bundles this module script once per page no matter how many Expandables
  // are used, so the listener is attached to every toggle exactly once.
  document.querySelectorAll('.expand-toggle').forEach((button) => {
    button.addEventListener('click', function () {
      const isOpen = this.classList.toggle('active');
      this.nextElementSibling?.classList.toggle('active', isOpen);
      this.setAttribute('aria-expanded', String(isOpen));
    });
  });
</script>
