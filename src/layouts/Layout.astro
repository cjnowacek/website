---
// src/layouts/Layout.astro — ported from includes/header.php + footer.php
import { siteName, siteTitle, siteDescription, navItems, socialLinks } from '../config.js';
// Bundle the global CSS through Astro so it gets a content-hashed filename.
// This auto-busts the browser cache whenever the CSS changes (the old
// /static/css/main.css link cached its @import'd files indefinitely).
import '../../static/css/main.css';

const { title } = Astro.props;
const pageTitle = title ? `${title} - ${siteName}` : siteTitle;

// Active-nav highlighting based on the real request path.
// (Fixes the PHP version, which compared clean-URL nav keys against .php values
//  and so never actually matched.)
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isActive(href) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}

const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="CJ Nowacek" />
    <meta name="description" content={siteDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>
  <body>
    <div class="title__container">
      <h1><a href="/" style="color: inherit; text-decoration: none;">{siteName}</a></h1>
      <nav>
        {navItems.map(([href, label]) => (
          <a href={href} class={isActive(href) ? 'active' : undefined}>{label}</a>
        ))}
      </nav>
    </div>

    <slot />

    <div class="site-footer">
      <p class="footer-links">
        <a href={socialLinks.github} target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> GitHub</a>
        <a href={socialLinks.linkedin} target="_blank" rel="noopener"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>
        <a href={socialLinks.vimeo} target="_blank" rel="noopener"><i class="fa-brands fa-vimeo"></i> Demo Reel</a>
        <a href={socialLinks.email}><i class="fa-solid fa-envelope"></i> Email</a>
      </p>
      <p class="subtext">&copy; {year} {siteName}. All rights reserved.</p>
    </div>

    <script>
      // Play hover-preview videos on card hover; pause and rewind on leave
      document.querySelectorAll('.project-card').forEach((card) => {
        const video = card.querySelector('.hover-video');
        if (!video) return;
        card.addEventListener('mouseenter', () => {
          video.currentTime = 0;
          video.play().catch(() => {});
        });
        card.addEventListener('mouseleave', () => {
          video.pause();
        });
      });

      // Whole card is clickable; real links inside keep working normally
      document.querySelectorAll('.project-card[data-href]').forEach((card) => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('a')) return;
          window.location = card.dataset.href;
        });
      });
    </script>
  </body>
</html>
