---
// src/layouts/ProjectDetail.astro — shared wrapper for every project detail page.
// The MDX body is slotted in below the title.
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getPostsForProject, formatDate } from '../lib/devlog.js';

const { project } = Astro.props;
const d = project.data;
const categoryLabel = d.category === 'devops' ? 'Pipeline' : 'Technical Art';
const categoryHref = d.category === 'devops' ? '/devops' : '/techart';
const title = d.pageTitle ?? `${d.title} - ${categoryLabel}`;
// Media first: the card image (or an explicit `hero`) sits under the title.
const heroSrc = d.hero ?? d.image;
const heroIsVideo = !!heroSrc && /\.mp4$/i.test(heroSrc);
const posts = await getPostsForProject(project.id);

// At-a-glance facts under the hero: what the role was, where, when, with whom.
const facts = [
  ['Role', d.meta?.role],
  ['Studio', d.company],
  ['When', d.meta?.duration],
  ['Team', d.meta?.team_size],
  ['Platform', d.meta?.platforms],
].filter(([, v]) => v);
---
<Layout title={title} description={d.tagline ?? d.description} image={d.image ?? undefined} type="article">
  <div class="container" style="max-width: 1300px;">
    <Breadcrumb
      crumbs={[
        { label: 'Home', href: '/' },
        { label: categoryLabel, href: categoryHref },
        { label: d.title },
      ]}
    />

    <h2>{d.title}</h2>

    {heroSrc && (
      <figure class="detail-hero">
        {heroIsVideo ? (
          <video src={heroSrc} poster={d.image ?? undefined} autoplay muted loop playsinline aria-label={`${d.title} demo`}></video>
        ) : (
          <img src={heroSrc} alt={d.title} width="1200" height="900" fetchpriority="high" />
        )}
        {d.heroCaption && <figcaption>{d.heroCaption}</figcaption>}
      </figure>
    )}

    {(facts.length > 0 || d.tech_tags.length > 0) && (
      <dl class="project-facts">
        {facts.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
        {d.tech_tags.length > 0 && (
          <div class="project-facts-tools">
            <dt>Tools</dt>
            <dd>
              <ul class="tech-tags">
                {d.tech_tags.map((t) => <li class="tech-tag">{t}</li>)}
              </ul>
            </dd>
          </div>
        )}
      </dl>
    )}

    <slot />

    {posts.length > 0 && (
      <section class="text-content project-posts">
        <h3>From the Dev Log</h3>
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/devlog/${post.id}/`}>{post.data.title}</a>
              <span class="devlog-meta"> &middot; {formatDate(post.data.date)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div style="display: flex; justify-content: flex-start; margin: 60px 0 40px 0; gap: 20px;">
      <a href={categoryHref} class="project-link" style="background: var(--form-bg); color: var(--text-color);">
        ← Back to {categoryLabel}
      </a>
    </div>
  </div>
</Layout>
